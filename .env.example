# Load this explicitly in your shell; the application does not read .env implicitly.
APP_ENV=development
DATABASE_URL=postgresql+psycopg2://tracely:CHANGE_ME@localhost:5432/tracely
# Generate using: python -c 'import secrets; print(secrets.token_urlsafe(48))'
SESSION_SECRET=
DATASET_ID=spedia-v2
FRONTEND_URL=http://localhost:8000
# Frontend uses same-origin Vite proxy by default. This is the only API variable.
VITE_API_URL=
FEATURE_PATH=data/spedia/features-temporal/features.parquet
ARTIFACT_ROOT=data/artifacts
ALLOW_FIXTURE_DATA=0
# JSON mapping names to password_hash and VIEWER/ANALYST/ADMIN roles. Never plaintext passwords.
# Create with python -m scripts.create_dev_account admin ADMIN, then export DEV_AUTH_USERS output.
DEV_AUTH_USERS={}
# Production requires HTTPS, secure cookies, and OIDC; local login is disabled.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=https://your-api.example/api/auth/callback
# Provision exact identity-provider subjects, e.g. {"subject-id":"ANALYST"}
OIDC_ROLES={}
# Compose only: choose a unique PostgreSQL password; no default credential is shipped.
POSTGRES_PASSWORD=

# Frozen SPEDIA analysis and chronological replay inputs; provision before use.
REPLAY_DIRECTORY=data/spedia/review-v3
REALISTIC_REPLAY_DIRECTORY=data/spedia/replay-realistic-v1

# Offline-provisioned label-free causal history for raw CSV inference
INFERENCE_CONTEXT_DIRECTORY=
